# Copy to .env (git-ignored) and fill in. The ADO skill scripts load this file automatically.
# Create the PAT at https://dev.azure.com/<org>/_usersSettings/tokens with these scopes:
#   Work Items: Read
#   Build: Read & execute   (Read is enough if you never use --queue)
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-org
AZURE_DEVOPS_PROJECT=YourProject
AZURE_DEVOPS_PAT=
# Optional: the pipeline (definition) ID from the pipeline URL (...?definitionId=42).
# Needed for --queue, and stops the monitor from picking up builds from other pipelines.
AZURE_DEVOPS_PIPELINE_ID=
